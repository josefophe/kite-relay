# Core runtime
NODE_ENV=production
IS_WORKER=false

# Telegram relay configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
APP_SECRET=replace-with-a-long-random-secret

# AI / LLM configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo
LLM_API_KEY=your_llm_api_key_here
LLM_MAX_ITERATIONS=5
LLM_TIMEOUT=30000

# Database configuration
DATABASE_URL=sqlite:///data/agents.db
DB_TYPE=sqlite

# User storage and Kite CLI integration
USER_DATA_ROOT=/data
KPASS_BINARY=kpass
KSEARCH_BINARY=ksearch

# HTTP binding and host
PORT=3000
HOST=0.0.0.0

# Redis queue and cache (shared between relay and worker)
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Scheduler / worker tuning
AGENT_SCHEDULER_ENABLED=true
WORKER_CONCURRENCY=4
AGENT_RETRY_BACKOFF_BASE=1000
AGENT_MAX_RETRIES=3
WORKER_TIMEOUT=30000

# Optional commerce / integration credentials
RELOADLY_CLIENT_ID=your_reloadly_client_id_here
RELOADLY_CLIENT_SECRET=your_reloadly_client_secret_here

# Optional alias for worker encryption key
# ENCRYPTION_KEY can be set to the same value as APP_SECRET if needed
ENCRYPTION_KEY=replace-with-a-long-random-secret
